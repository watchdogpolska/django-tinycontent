{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "group:allNonMajor"
  ],
  "baseBranchPatterns": ["dev"],
  "enabledManagers": ["pep621", "github-actions"],
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies"]
}
